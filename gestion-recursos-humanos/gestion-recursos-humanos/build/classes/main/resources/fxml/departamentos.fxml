<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- No se agrega "stylesheets" aquí a propósito: esta vista se carga dentro
     del contentPane del Dashboard, y ya hereda los estilos que dashboard.fxml
     tiene cargados en su nodo raíz. -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.com.pbcorporations.gestion.recursos.humanos.controller.DepartamentoController"
      spacing="15">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Departamentos" styleClass="title-label"/>
    <Label text="Registra las áreas de la empresa" styleClass="subtitle-label"/>

    <VBox styleClass="form-card" spacing="10">
        <HBox spacing="15">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Nombre del departamento" styleClass="form-label"/>
                <TextField fx:id="fieldNombre" styleClass="form-field" promptText="Ej. Ventas"/>
            </VBox>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Descripción" styleClass="form-label"/>
                <TextField fx:id="fieldDescripcion" styleClass="form-field" promptText="Ej. Comercialización y atención al cliente"/>
            </VBox>
        </HBox>

        <HBox spacing="10">
            <Button text="Guardar" styleClass="btn-save" onAction="#handleGuardar"/>
            <Button text="Actualizar" styleClass="btn-update" onAction="#handleActualizar"/>
            <Button text="Eliminar" styleClass="btn-delete" onAction="#handleEliminar"/>
            <Button text="Limpiar" onAction="#handleLimpiar"/>
        </HBox>
    </VBox>

    <TableView fx:id="tableDepartamentos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="columnId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="columnNombre" text="Nombre" prefWidth="220"/>
            <TableColumn fx:id="columnDescripcion" text="Descripción" prefWidth="350"/>
        </columns>
    </TableView>

</VBox>
