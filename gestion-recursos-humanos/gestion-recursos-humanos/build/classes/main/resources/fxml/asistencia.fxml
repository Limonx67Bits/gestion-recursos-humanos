<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="main.java.com.pbcorporations.gestion.recursos.humanos.controller.AsistenciaController"
      spacing="15">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Marcaje de Asistencia" styleClass="title-label"/>
    <Label fx:id="labelFechaHoy" text="Fecha:" styleClass="subtitle-label"/>

    <VBox styleClass="form-card" spacing="10">
        <VBox spacing="4">
            <Label text="Empleado" styleClass="form-label"/>
            <ComboBox fx:id="comboEmpleados" styleClass="form-field" maxWidth="Infinity" promptText="Selecciona un empleado"/>
        </VBox>

        <HBox spacing="10">
            <Button text="Marcar entrada" styleClass="btn-save" onAction="#handleMarcarEntrada"/>
            <Button text="Marcar salida" styleClass="btn-update" onAction="#handleMarcarSalida"/>
        </HBox>
    </VBox>

    <Label text="Asistencias de hoy" styleClass="form-label"/>

    <TableView fx:id="tableAsistencias" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="columnEmpleado" text="Empleado" prefWidth="220"/>
            <TableColumn fx:id="columnEntrada" text="Entrada" prefWidth="120"/>
            <TableColumn fx:id="columnSalida" text="Salida" prefWidth="120"/>
            <TableColumn fx:id="columnEstado" text="Estado" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>
