<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="main.java.com.pbcorporations.gestion.recursos.humanos.controller.DashboardController"
            stylesheets="@../css/styles.css,@../css/dashboard.css,@../css/forms.css,@../css/tables.css,@../css/alerts.css">

    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="4">
            <padding>
                <javafx.geometry.Insets top="20" right="10" bottom="20" left="10"/>
            </padding>

            <Label text="RRHH Kinal" styleClass="sidebar-title">
                <VBox.margin>
                    <javafx.geometry.Insets bottom="25" left="8"/>
                </VBox.margin>
            </Label>

            <Button fx:id="btnDepartamentos" text="Departamentos" styleClass="menu-button"
                    maxWidth="Infinity" onAction="#handleDepartamentos"/>
            <Button fx:id="btnAsistencia" text="Marcaje de Asistencia" styleClass="menu-button"
                    maxWidth="Infinity" onAction="#handleAsistencia"/>
            <Button fx:id="btnHorasExtra" text="Horas Extra" styleClass="menu-button"
                    maxWidth="Infinity" onAction="#handleHorasExtra"/>

            <!-- El resto del equipo agrega aquí sus propios botones
                 (Empleados, Nómina, Usuarios, etc.) siguiendo el mismo patrón. -->
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentPane" styleClass="content-pane"/>
    </center>

</BorderPane>
