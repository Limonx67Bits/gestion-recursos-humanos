<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.pbcorporations.gestion.recursos.humanos.controller.AsistenciaController">
   <stylesheets>
      <URL value="@../css/styles.css" />
      <URL value="@../css/forms.css" />
      <URL value="@../css/tables.css" />
   </stylesheets>
   <top>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="title-label" text="Asistencia y Horas Extra" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </VBox>
   </top>

   <left>
      <VBox spacing="15.0" styleClass="form-card" prefWidth="280.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="labelFechaHoy" styleClass="subtitle-label" text="Fecha:" />

            <VBox spacing="4.0">
               <children>
                  <Label styleClass="form-label" text="Empleado" />
                  <ComboBox fx:id="comboEmpleados" maxWidth="Infinity" promptText="Selecciona un empleado" styleClass="form-field" />
               </children>
            </VBox>

            <Button maxWidth="Infinity" onAction="#handleMarcarEntrada" styleClass="btn-save" text="Marcar entrada" />
            <Button maxWidth="Infinity" onAction="#handleMarcarSalida" styleClass="btn-update" text="Marcar salida" />

            <Button mnemonicParsing="false" onAction="#regresar" styleClass="btn-delete" text="X" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>

   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="form-label" text="Asistencias de hoy" />
            <TableView fx:id="tableAsistenciasHoy" prefHeight="220.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="columnEmpleadoHoy" prefWidth="200.0" text="Empleado" />
                  <TableColumn fx:id="columnEntrada" prefWidth="110.0" text="Entrada" />
                  <TableColumn fx:id="columnSalida" prefWidth="110.0" text="Salida" />
                  <TableColumn fx:id="columnEstado" prefWidth="110.0" text="Estado" />
               </columns>
            </TableView>

            <Label styleClass="form-label" text="Registrar horas extra (jornadas con salida ya marcada)" />
            <TableView fx:id="tableHorasExtra" prefHeight="220.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="columnEmpleadoHE" prefWidth="200.0" text="Empleado" />
                  <TableColumn fx:id="columnFechaHE" prefWidth="110.0" text="Fecha" />
                  <TableColumn fx:id="columnHorasExtra" prefWidth="110.0" text="Horas extra" />
               </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="form-card">
               <children>
                  <Label styleClass="form-label" text="Horas extra:" />
                  <TextField fx:id="fieldHorasExtra" promptText="Ej. 2.5" styleClass="form-field" />
                  <Button onAction="#handleGuardarHorasExtra" styleClass="btn-update" text="Guardar" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="15.0" left="10.0" right="20.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
