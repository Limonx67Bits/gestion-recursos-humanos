<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.pbcorporations.gestion.recursos.humanos.controller.LoginController">
    <stylesheets>
        <URL value="@/main/resources/css/styles.css" />
    </stylesheets>
   <children>
      <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" styleClass="separator" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <center>
            <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="5.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="20.0" left="100.0" right="100.0" top="20.0" />
               </padding>
               <children>
                  <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="5.0" styleClass="login-container">
                     <children>
                        <Label styleClass="login-title" text="Iniciar Sesión" />
                        <Label styleClass="subtitle-label" text="Sistema de RRHH - Planilla" />
                        <Region prefHeight="9.0" prefWidth="340.0" />
                        <Label text="Usuario" />
                        <TextField fx:id="txtUsername" styleClass="text-field" />
                        <Label text="Contraseña" />
                        <PasswordField fx:id="txtPassword" styleClass="password-field" />
                        <Region prefHeight="9.0" prefWidth="340.0" />
                        <Button mnemonicParsing="false" onAction="#handleLogin" styleClass="login-button" text="Iniciar Sesión" />
                        <Region prefHeight="9.0" prefWidth="340.0" />
                        <Label text="Aún no tienes un usuario? Regístrate" />
                        <Button mnemonicParsing="false" onAction="#handleShowRegister" styleClass="login-button" text="Registrarse" />
                     </children>
                     <padding>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                     </padding>
                     <effect>
                        <InnerShadow />
                     </effect>
                  </VBox>
               </children>
            </VBox>
         </center>
         <stylesheets>
            <URL value="@../css/styles.css" />
            <URL value="@../css/login.css" />
         </stylesheets>
      </BorderPane>
   </children>
</AnchorPane>
