<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.pbcorporations.gestion.recursos.humanos.controler.EmpleadoController">
   <stylesheets>
      <URL value="@../css/styles.css" />
      <URL value="@../css/forms.css" />
      <URL value="@../css/tables.css" />
   </stylesheets>
   <top>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="title-label" text="Gestión de Empleados" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </VBox>
   </top>
   <left>
      <VBox spacing="15.0" styleClass="form-card" BorderPane.alignment="CENTER">
         <children>
            <GridPane hgap="8.0" vgap="10.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="125.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="125.0" />
               </columnConstraints>
               <children>
                  <Label styleClass="form-label" text="ID:" GridPane.rowIndex="0" />
                  <TextField fx:id="txtId" disable="true" editable="false" promptText="ID (Auto-generado)" style="-fx-background-color: #e0e0e0; -fx-opacity: 1.0;" styleClass="form-field" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="0" />
                  
                  <Label styleClass="form-label" text="Nombres:" GridPane.rowIndex="1" />
                  <TextField fx:id="txtNombres" promptText="Nombres completos" styleClass="form-field" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="1" />
                  
                  <Label styleClass="form-label" text="Apellidos:" GridPane.rowIndex="2" />
                  <TextField fx:id="txtApellidos" promptText="Apellidos completos" styleClass="form-field" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="2" />
                  
                  <Label styleClass="form-label" text="DPI / Teléfono:" GridPane.rowIndex="3" />
                  <TextField fx:id="txtDpi" promptText="Número DPI" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <TextField fx:id="txtTelefono" promptText="Teléfono" styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="3" />

                  <Label styleClass="form-label" text="Correo:" GridPane.rowIndex="4" />
                  <TextField fx:id="txtCorreo" promptText="correo@kinal.edu.gt" styleClass="form-field" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="4" />
                  
                  <Label styleClass="form-label" text="Puesto / Depto:" GridPane.rowIndex="5" />
                  <TextField fx:id="txtPuesto" promptText="Puesto" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                  <TextField fx:id="txtDepartamento" promptText="Departamento" styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="5" />

                  <Label styleClass="form-label" text="Vialidad / Casa:" GridPane.rowIndex="6" />
                  <HBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="6">
                     <children>
                        <TextField fx:id="txtTipoVialidad" prefWidth="70.0" promptText="Tipo (Calle/Av)" styleClass="form-field" />
                        <TextField fx:id="txtNumeroVialidad" prefWidth="55.0" promptText="No." styleClass="form-field" />
                     </children>
                  </HBox>
                  <TextField fx:id="txtNumeroCasa" promptText="No. Casa/Lote" styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="6" />

                  <Label styleClass="form-label" text="Colonia / Zona:" GridPane.rowIndex="7" />
                  <TextField fx:id="txtColonia" promptText="Colonia/Barrio" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                  <TextField fx:id="txtZona" promptText="Zona" styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="7" />

                  <Label styleClass="form-label" text="Municipio / Depto:" GridPane.rowIndex="8" />
                  <TextField fx:id="txtMunicipio" promptText="Municipio" styleClass="form-field" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                  <TextField fx:id="txtDepartamentoDir" promptText="Depto Dirección" styleClass="form-field" GridPane.columnIndex="2" GridPane.rowIndex="8" />

                  <Label styleClass="form-label" text="Código Postal:" GridPane.rowIndex="9" />
                  <TextField fx:id="txtCodigoPostal" promptText="Ej: 01001" styleClass="form-field" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="9" />
               </children>
            </GridPane>
            
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button fx:id="btnGuardar" onAction="#handleGuardar" styleClass="btn-save" text="Guardar" />
                  <Button fx:id="btnActualizar" onAction="#handleActualizar" styleClass="btn-update" text="Actualizar" />
                  <Button fx:id="btnEliminar" onAction="#handleEliminar" styleClass="btn-delete" text="Eliminar" />
                  <Button fx:id="btnLimpiar" onAction="#limpiarCampos" text="Limpiar" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <TableView fx:id="tablaEmpleados" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="colDpi" prefWidth="100.0" text="DPI" />
          <TableColumn fx:id="colTelefono" prefWidth="90.0" text="Teléfono" />
          <TableColumn fx:id="colCorreo" prefWidth="130.0" text="Correo" />
          <TableColumn fx:id="colPuesto" prefWidth="110.0" text="Puesto" />
          <TableColumn fx:id="colDepartamento" prefWidth="110.0" text="Departamento" />
          <TableColumn fx:id="colColonia" prefWidth="100.0" text="Colonia" />
          <TableColumn fx:id="colZona" prefWidth="50.0" text="Zona" />
          <TableColumn fx:id="colMunicipio" prefWidth="100.0" text="Municipio" />
          <TableColumn fx:id="colCodigoPostal" prefWidth="85.0" text="Cód. Postal" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="15.0" left="10.0" right="20.0" top="10.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>