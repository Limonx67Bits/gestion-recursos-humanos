<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.pbcorporations.gestion.recursos.humanos.controler.EmpleadoController">
   <top>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Gestión de Empleados">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </VBox>
   </top>
   <left>
      <VBox spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <GridPane hgap="10.0" vgap="10.0">
               <children>
                  <Label text="ID:" GridPane.rowIndex="0" />
                  <TextField fx:id="txtId" editable="false" promptText="ID (Auto)" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                  
                  <Label text="Nombre:" GridPane.rowIndex="1" />
                  <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="DPI:" GridPane.rowIndex="2" />
                  <TextField fx:id="txtDpi" promptText="Número de DPI" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  
                  <Label text="Teléfono:" GridPane.rowIndex="3" />
                  <TextField fx:id="txtTelefono" promptText="Teléfono" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  
                  <Label text="Puesto:" GridPane.rowIndex="4" />
                  <TextField fx:id="txtPuesto" promptText="Puesto de trabajo" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                  <Label text="Departamento:" GridPane.rowIndex="5" />
                  <TextField fx:id="txtDepartamento" promptText="Departamento" GridPane.columnIndex="1" GridPane.rowIndex="5" />
               </children>
            </GridPane>
            <HBox spacing="10.0">
               <children>
                  <Button fx:id="btnGuardar" onAction="#handleGuardar" text="Guardar" />
                  <Button fx:id="btnEliminar" onAction="#handleEliminar" text="Eliminar" />
                  <Button fx:id="btnLimpiar" onAction="#limpiarCampos" text="Limpiar" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <TableView fx:id="tablaEmpleados" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
          <TableColumn fx:id="colDpi" prefWidth="110.0" text="DPI" />
          <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
          <TableColumn fx:id="colPuesto" prefWidth="110.0" text="Puesto" />
          <TableColumn fx:id="colDepartamento" prefWidth="120.0" text="Departamento" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="15.0" left="10.0" right="20.0" top="10.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>