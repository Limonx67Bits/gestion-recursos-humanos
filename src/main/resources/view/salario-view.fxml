<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.pbcorporations.gestion.recursos.humanos.controller.SalarioController">
    <stylesheets>
        <URL value="@../css/styles.css" />
        <URL value="@../css/dashboard.css" />
        <URL value="@../css/tables.css" />
        <URL value="@../css/payroll.css" />
        <URL value="@../css/forms.css" />
    </stylesheets>
   <children>
      <BorderPane prefHeight="400.0" prefWidth="600.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <top>
            <HBox alignment="CENTER_LEFT" prefHeight="47.0" prefWidth="600.0" spacing="5.0" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
               <children>
                  <Label styleClass="title-label" text="Salarios pendientes por cancelar" />
                  <Region maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#regresar" styleClass="btn-delete" text="X" />
               </children>
               <effect>
                  <InnerShadow />
               </effect>
            </HBox>
         </top>
         <center>
            <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="content-pane" BorderPane.alignment="CENTER">
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
               <children>
                  <VBox spacing="15.0" styleClass="payroll-card">
                     <children>
                        <TableView fx:id="tablaEmpleados" prefHeight="242.0" prefWidth="413.0">
                          <columns>
                            <TableColumn fx:id="colId" prefWidth="127.0" text="ID" />
                            <TableColumn fx:id="colCorreo" prefWidth="142.0" text="Correo" />
                            <TableColumn fx:id="colPuesto" prefWidth="107.0" text="Puesto" />
                            <TableColumn fx:id="colSueldo" prefWidth="132.0" text="sueldo " />
                          </columns>
                        </TableView>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <TextField fx:id="txtSueldo" prefHeight="26.0" prefWidth="200.0" promptText="sueldo empleado" styleClass="form-field" />
                              <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                              <Button fx:id="btnPagarNomina" mnemonicParsing="false" onAction="#pagar" styleClass="btn-save" text="Pagar nomina" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</AnchorPane>
