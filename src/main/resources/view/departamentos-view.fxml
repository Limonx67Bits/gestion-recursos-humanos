<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.pbcorporations.gestion.recursos.humanos.controller.DepartamentoController">
   <stylesheets>
      <URL value="@../css/styles.css" />
      <URL value="@../css/forms.css" />
      <URL value="@../css/tables.css" />
   </stylesheets>
   <top>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="title-label" text="Departamentos" />
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="15.0" />
         </padding>
      </VBox>
   </top>
   <left>
      <VBox spacing="15.0" styleClass="form-card" prefWidth="320.0" BorderPane.alignment="CENTER">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="form-label" text="Nombre del departamento" />
                  <TextField fx:id="fieldNombre" promptText="Ej. Ventas" styleClass="form-field" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="form-label" text="Descripción" />
                  <TextField fx:id="fieldDescripcion" promptText="Ej. Comercialización y atención al cliente" styleClass="form-field" />
               </children>
            </VBox>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button onAction="#handleGuardar" styleClass="btn-save" text="Guardar" />
                  <Button onAction="#handleActualizar" styleClass="btn-update" text="Actualizar" />
                  <Button onAction="#handleEliminar" styleClass="btn-delete" text="Eliminar" />
                  <Button onAction="#handleLimpiar" text="Limpiar" />
                  <Button mnemonicParsing="false" onAction="#regresar" styleClass="btn-delete" text="X" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="20.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </left>
   <center>
      <TableView fx:id="tableDepartamentos" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="columnId" prefWidth="60.0" text="ID" />
          <TableColumn fx:id="columnNombre" prefWidth="220.0" text="Nombre" />
          <TableColumn fx:id="columnDescripcion" prefWidth="350.0" text="Descripción" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="15.0" left="10.0" right="20.0" top="10.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
